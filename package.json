{
  "name": "garagebench",
  "private": true,
  "version": "0.1.0",
  "description": "GarageBench MVP for assisted automotive diagnostics",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "electron/main.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "bootstrap": "npm --prefix backend install && npm --prefix frontend install",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend run start:dev",
    "start:all": "concurrently \"npm --prefix backend run start:dev\" \"npm --prefix frontend run start\"",
    "desktop:dev": "electron .",
    "desktop:pack": "npm run build:all && electron-builder --win --x64 --publish=never",
    "desktop:pack:nsis": "npm run build:all && electron-builder --win --x64 nsis --publish=never",
    "test": "npm --prefix backend run test && npm --prefix frontend run test",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-builder-squirrel-windows": "^24.13.3",
    "wait-on": "^8.0.4",
    "concurrently": "^8.2.2"
  },
  "build": {
    "appId": "com.winnersat2012.garagebench",
    "productName": "GarageBench",
    "files": [
      "electron/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "backend/src/**/*",
      "backend/tsconfig.json",
      "frontend/dist/**/*",
      "frontend/package.json",
      "frontend/src/**/*",
      "frontend/angular.json",
      "frontend/tsconfig.json",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
